# Copy to .env (or run: hmac-guard init). Values ending in ? in the config are optional:
# a route whose secrets are all empty is disabled with a warning.

# Your partners' HMAC secrets (generate with: hmac-guard keygen --client acme)
ACME_HMAC_SECRET=
GLOBEX_HMAC_SECRET=

# Provider webhook secrets (copy from each dashboard)
STRIPE_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=
RESEND_WEBHOOK_SECRET=

# Where verified requests go (n8n / Make / Zapier / your API). Empty = acknowledge only.
PARTNER_UPSTREAM_URL=
STRIPE_UPSTREAM_URL=
GITHUB_UPSTREAM_URL=
SHOPIFY_UPSTREAM_URL=
TWILIO_UPSTREAM_URL=
# Optional: gateway signs forwarded calls so the upstream can check they came from the gateway
UPSTREAM_SIGNING_SECRET=

# Public https origin when behind a proxy (needed for Twilio), e.g. https://hooks.example.com
PUBLIC_BASE_URL=

# /metrics bearer token (empty = open)
METRICS_TOKEN=

# Share rate limits and replay protection between several instances
REDIS_URL=
